// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "npm",
            "script": "build",
            "label": "npm: build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "Lint, typecheck and tests",
            "command": "npm run lint && npm run typecheck && npm test",
            "group": "test",
            "problemMatcher": "$tsc"
        }
    ]
}
