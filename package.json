{
  "name": "claude-sandbox-vscode",
  "displayName": "Claude Sandbox for VS Code",
  "description": "Run a sandboxed Claude Code in VS Code with claude-sandbox: its terminal in the editor, selections, diffs, presets and a list of what it changed.",
  "version": "0.0.1",
  "publisher": "diamondlightsource",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#2b2f36",
    "theme": "dark"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/DiamondLightSource/claude-sandbox-vscode.git"
  },
  "engines": {
    "vscode": "^1.105.0",
    "node": ">=22.18"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "claude",
    "claude code",
    "sandbox",
    "devcontainer",
    "mcp"
  ],
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "The extension never runs workspace content; keep workspaces the sandbox can write untrusted."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "claudeSandbox.start",
        "title": "Start",
        "category": "Claude Sandbox",
        "icon": "$(sparkle)"
      },
      {
        "command": "claudeSandbox.preset.explain",
        "title": "Explain",
        "category": "Claude Sandbox"
      },
      {
        "command": "claudeSandbox.preset.reword",
        "title": "Reword",
        "category": "Claude Sandbox"
      },
      {
        "command": "claudeSandbox.preset.tighten",
        "title": "Tighten",
        "category": "Claude Sandbox"
      },
      {
        "command": "claudeSandbox.customPreset",
        "title": "My presets…",
        "category": "Claude Sandbox"
      },
      {
        "command": "claudeSandbox.runPreset",
        "title": "Run preset",
        "category": "Claude Sandbox"
      },
      {
        "command": "claudeSandbox.mention",
        "title": "Mention in Claude",
        "category": "Claude Sandbox"
      },
      {
        "command": "claudeSandbox.openChange",
        "title": "Open diff",
        "category": "Claude Sandbox"
      },
      {
        "command": "claudeSandbox.markReviewed",
        "title": "Mark as reviewed",
        "category": "Claude Sandbox",
        "icon": "$(check)"
      },
      {
        "command": "claudeSandbox.markAllReviewed",
        "title": "Mark all as reviewed",
        "category": "Claude Sandbox",
        "icon": "$(check-all)"
      },
      {
        "command": "claudeSandbox.markUnreviewed",
        "title": "Mark as not reviewed",
        "category": "Claude Sandbox"
      },
      {
        "command": "claudeSandbox.openChangedFile",
        "title": "Open File",
        "category": "Claude Sandbox",
        "icon": "$(go-to-file)"
      },
      {
        "command": "claudeSandbox.stageChange",
        "title": "Stage",
        "category": "Claude Sandbox",
        "icon": "$(add)"
      },
      {
        "command": "claudeSandbox.revertChange",
        "title": "Revert to HEAD",
        "category": "Claude Sandbox",
        "icon": "$(discard)"
      },
      {
        "command": "claudeSandbox.revertAll",
        "title": "Revert All Changes to HEAD",
        "category": "Claude Sandbox",
        "icon": "$(discard)"
      },
      {
        "command": "claudeSandbox.revealChange",
        "title": "Reveal in Explorer View",
        "category": "Claude Sandbox"
      },
      {
        "command": "claudeSandbox.copyChangePath",
        "title": "Copy Path",
        "category": "Claude Sandbox"
      },
      {
        "command": "claudeSandbox.copyChangeRelativePath",
        "title": "Copy Relative Path",
        "category": "Claude Sandbox"
      },
      {
        "command": "claudeSandbox.reviewAll",
        "title": "Review All Changes",
        "category": "Claude Sandbox",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "claudeSandbox.previousChange",
        "title": "Previous Change",
        "category": "Claude Sandbox",
        "icon": "$(arrow-up)"
      },
      {
        "command": "claudeSandbox.nextChange",
        "title": "Next Change",
        "category": "Claude Sandbox",
        "icon": "$(arrow-down)"
      },
      {
        "command": "claudeSandbox.copySettings",
        "title": "Copy launch command (advanced)",
        "category": "Claude Sandbox"
      },
      {
        "command": "claudeSandbox.acceptDiff",
        "title": "Accept proposed change",
        "category": "Claude Sandbox",
        "icon": "$(check)"
      },
      {
        "command": "claudeSandbox.rejectDiff",
        "title": "Reject proposed change",
        "category": "Claude Sandbox",
        "icon": "$(close)"
      }
    ],
    "configuration": {
      "title": "Claude Sandbox",
      "properties": {
        "claudeSandbox.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "application",
          "markdownDescription": "Extra arguments for Claude Code when **Claude Sandbox: Start** runs it, e.g. `[\"--model\", \"opus\"]`. User settings only: a workspace cannot set this. A `--settings` here must be JSON (the link's settings are merged into it), not a file."
        },
        "claudeSandbox.presets": {
          "type": "array",
          "default": [],
          "scope": "application",
          "items": {
            "type": "object",
            "required": [
              "title",
              "prompt"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "markdownDescription": "Your own presets for **Claude Sandbox: My presets…**, and first in the **Refactor…** menu on a selection: `{\"title\": …, \"prompt\": …}`. The prompt is sent with the selection attached. User settings only: a workspace cannot set this."
        },
        "claudeSandbox.autoOpenDiffs": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "markdownDescription": "Open the diff against HEAD as a preview when Claude changes a file during the session. User settings only."
        },
        "claudeSandbox.reviewEdits": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "markdownDescription": "Make Claude Code ask before every `Edit`, `Write` and `NotebookEdit`, in auto mode too, so each such edit opens here as a diff to accept or reject. Edits made through the shell (`sed -i`, `echo > file`) are not caught: the **Changed this session** view lists them. User settings only."
        }
      }
    },
    "keybindings": [
      {
        "command": "claudeSandbox.start",
        "key": "ctrl+alt+c ctrl+alt+c"
      },
      {
        "command": "claudeSandbox.preset.explain",
        "key": "ctrl+alt+c e",
        "when": "editorTextFocus && resourceScheme == file"
      },
      {
        "command": "claudeSandbox.preset.reword",
        "key": "ctrl+alt+c r",
        "when": "editorTextFocus && resourceScheme == file"
      },
      {
        "command": "claudeSandbox.preset.tighten",
        "key": "ctrl+alt+c t",
        "when": "editorTextFocus && resourceScheme == file"
      },
      {
        "command": "claudeSandbox.customPreset",
        "key": "ctrl+alt+c p",
        "when": "editorTextFocus && resourceScheme == file"
      },
      {
        "command": "claudeSandbox.mention",
        "key": "ctrl+alt+c m",
        "when": "editorTextFocus && resourceScheme == file"
      },
      {
        "command": "claudeSandbox.reviewAll",
        "key": "ctrl+alt+c v"
      },
      {
        "command": "claudeSandbox.nextChange",
        "key": "f8",
        "when": "claudeSandbox.reviewing && activeEditor == 'multiDiffEditor' || focusedView == 'claudeSandbox.changes'"
      },
      {
        "command": "claudeSandbox.previousChange",
        "key": "shift+f8",
        "when": "claudeSandbox.reviewing && activeEditor == 'multiDiffEditor' || focusedView == 'claudeSandbox.changes'"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "claudeSandbox.acceptDiff",
          "when": "resourceScheme == claude-sandbox-proposal || resourceScheme == claude-sandbox-original",
          "group": "navigation@1"
        },
        {
          "command": "claudeSandbox.rejectDiff",
          "when": "resourceScheme == claude-sandbox-proposal || resourceScheme == claude-sandbox-original",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "claudeSandbox.acceptDiff",
          "when": "resourceScheme == claude-sandbox-proposal || resourceScheme == claude-sandbox-original"
        },
        {
          "command": "claudeSandbox.rejectDiff",
          "when": "resourceScheme == claude-sandbox-proposal || resourceScheme == claude-sandbox-original"
        },
        {
          "command": "claudeSandbox.openChange",
          "when": "false"
        },
        {
          "command": "claudeSandbox.markReviewed",
          "when": "false"
        },
        {
          "command": "claudeSandbox.runPreset",
          "when": "false"
        },
        {
          "command": "claudeSandbox.markUnreviewed",
          "when": "false"
        },
        {
          "command": "claudeSandbox.openChangedFile",
          "when": "false"
        },
        {
          "command": "claudeSandbox.stageChange",
          "when": "false"
        },
        {
          "command": "claudeSandbox.revertChange",
          "when": "false"
        },
        {
          "command": "claudeSandbox.revealChange",
          "when": "false"
        },
        {
          "command": "claudeSandbox.copyChangePath",
          "when": "false"
        },
        {
          "command": "claudeSandbox.copyChangeRelativePath",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "claudeSandbox.start",
          "group": "claudeSandbox@1",
          "when": "explorerResourceIsRoot && resourceScheme == file && !claudeSandbox.running"
        }
      ],
      "editor/context": [
        {
          "submenu": "claudeSandbox.editor",
          "group": "claudeSandbox@1",
          "when": "resourceScheme == file"
        }
      ],
      "claudeSandbox.editor": [
        {
          "command": "claudeSandbox.preset.explain",
          "group": "1_presets@1"
        },
        {
          "command": "claudeSandbox.preset.reword",
          "group": "1_presets@2"
        },
        {
          "command": "claudeSandbox.preset.tighten",
          "group": "1_presets@3"
        },
        {
          "command": "claudeSandbox.customPreset",
          "group": "1_presets@4"
        },
        {
          "command": "claudeSandbox.mention",
          "group": "2_mention@1"
        }
      ],
      "view/title": [
        {
          "command": "claudeSandbox.reviewAll",
          "when": "view == claudeSandbox.changes",
          "group": "navigation@0"
        },
        {
          "command": "claudeSandbox.previousChange",
          "when": "view == claudeSandbox.changes",
          "group": "navigation@1"
        },
        {
          "command": "claudeSandbox.nextChange",
          "when": "view == claudeSandbox.changes",
          "group": "navigation@2"
        },
        {
          "command": "claudeSandbox.markAllReviewed",
          "when": "view == claudeSandbox.changes",
          "group": "navigation@3"
        },
        {
          "command": "claudeSandbox.start",
          "when": "view == claudeSandbox.changes && !claudeSandbox.running",
          "group": "navigation@4"
        },
        {
          "command": "claudeSandbox.revertAll",
          "when": "view == claudeSandbox.changes",
          "group": "1_revert@1"
        }
      ],
      "view/item/context": [
        {
          "command": "claudeSandbox.markReviewed",
          "when": "view == claudeSandbox.changes && viewItem =~ /^change;unreviewed/",
          "group": "inline"
        },
        {
          "command": "claudeSandbox.openChangedFile",
          "when": "view == claudeSandbox.changes && viewItem =~ /^change;/ && !(viewItem =~ /;(deleted|symlink)(;|$)/)",
          "group": "1_open@1"
        },
        {
          "command": "claudeSandbox.markReviewed",
          "when": "view == claudeSandbox.changes && viewItem =~ /^change;unreviewed/",
          "group": "2_review@1"
        },
        {
          "command": "claudeSandbox.markUnreviewed",
          "when": "view == claudeSandbox.changes && viewItem =~ /^change;reviewed/",
          "group": "2_review@2"
        },
        {
          "command": "claudeSandbox.stageChange",
          "when": "view == claudeSandbox.changes && viewItem =~ /^change;/ && viewItem =~ /;git(;|$)/",
          "group": "3_git@1"
        },
        {
          "command": "claudeSandbox.revertChange",
          "when": "view == claudeSandbox.changes && viewItem =~ /^change;/ && viewItem =~ /;git(;|$)/",
          "group": "3_git@2"
        },
        {
          "command": "claudeSandbox.revealChange",
          "when": "view == claudeSandbox.changes && viewItem =~ /^change;/ && !(viewItem =~ /;deleted(;|$)/)",
          "group": "4_reveal@1"
        },
        {
          "command": "claudeSandbox.copyChangePath",
          "when": "view == claudeSandbox.changes && viewItem =~ /^change;/",
          "group": "5_copy@1"
        },
        {
          "command": "claudeSandbox.copyChangeRelativePath",
          "when": "view == claudeSandbox.changes && viewItem =~ /^change;/",
          "group": "5_copy@2"
        }
      ]
    },
    "submenus": [
      {
        "id": "claudeSandbox.editor",
        "label": "Claude Sandbox"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeSandbox",
          "title": "Claude Sandbox",
          "icon": "media/claude-sandbox.svg"
        }
      ]
    },
    "views": {
      "claudeSandbox": [
        {
          "id": "claudeSandbox.changes",
          "name": "Changed this session",
          "icon": "media/claude-sandbox.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "claudeSandbox.changes",
        "contents": "Files Claude changes while the linked session runs are listed here, each with its diff against HEAD.\n[Start Claude Sandbox](command:claudeSandbox.start)",
        "when": "!claudeSandbox.running"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --target=node20 --format=cjs --external:vscode --outfile=dist/extension.cjs --sourcemap",
    "typecheck": "tsc -p . --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "package": "npm run build && vsce package --no-dependencies",
    "vscode:prepublish": "npm run build -- --minify"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "@types/vscode": "1.105.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
